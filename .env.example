# VisionForge AI Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database: SQLite for zero-config portable dev, or PostgreSQL URI
# Examples:
# DATABASE_URL=sqlite:///./visionforge.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/visionforge
DATABASE_URL=sqlite:///./visionforge.db

# Storage Directories
ARTIFACTS_DIR=./data/artifacts
REPORTS_DIR=./data/reports

# Multimodal Model API Keys (Leave empty to use calibrated Demo Adapter)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default Benchmark Settings
DEFAULT_SEED=42
DEFAULT_IMAGE_WIDTH=800
DEFAULT_IMAGE_HEIGHT=600
